# ---- data files: NEVER commit patient data ----
# A single extension list, deliberately broad. The audit needs csv/xlsx
# input, and SPSS exports (.sav) are how the thesis data started life;
# any of them may contain identifiable clinical records.
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.sav
*.dta
*.parquet
*.feather
*.json.gz
*.sqlite
*.db

# ---- paper sources kept local ----
# The published corpus is sources/thesis_en.txt (CC BY 4.0, tracked
# deliberately). The original .docx writes stay on the author's machine.
*.docx
*.doc
*.odt
sources/thesis_en.txt.islocal

# ---- generated documents ----
# PDFs are build output, not source. The manual generators live outside
# this repo in ~/workspace/veritas-study/ (book/*.py) so neither the
# artefacts nor their sources belong in history. README figures are PNGs
# and stay tracked.
*.pdf

# ---- secrets ----
*.env
.env
.env.*
*.pem
*.key
secrets.json
setup.json

# ---- runtime artefacts (regenerated by a run) ----
audit_report.json
audit_report_*.json
chat_history.json
extracted_values.json
extracted_values_*.json
store.json

# ---- environments / caches ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- OS / editor noise ----
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
